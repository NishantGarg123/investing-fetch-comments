# Database Connection Settings
DB_DRIVER={ODBC Driver 17 for SQL Server}
# If running locally on Windows: DB_SERVER=localhost (or .\SQLEXPRESS)
# If running inside Docker container to connect to host SQL Server: DB_SERVER=host.docker.internal
DB_SERVER=localhost
DB_NAME=InvestingDB
DB_USER=sa
DB_PASSWORD=your_strong_password
# Note: In Docker, use SQL Server Authentication (DB_TRUSTED_CONNECTION=no) with DB_USER and DB_PASSWORD
DB_TRUSTED_CONNECTION=no
DB_ENCRYPT=no
DB_TRUST_CERT=yes

# Scraper Settings
MAX_PAGES_PER_USER=1
REQUEST_TIMEOUT=15
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=2.5

# API Server Settings (Optional)
API_PORT=3000
LOG_FILE=comment_scraper.log

# API Security Key (Used to secure scraper & billing endpoints)
API_KEY=you

# AWS Credentials for Billing / Cost Explorer API
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-west-2
# AWS_SESSION_TOKEN=optional_session_token_if_using_sts

# Proxy Settings (Optional)
# Specify a list of proxies directly in .env (comma or newline separated)
# or specify the path to a proxy text file (default looks for proxies.txt)
# Formats supported: username:password.ip:port, username:password@ip:port, username:password:ip:port
# PROXIES=username:password.218.218.252:5432,username2:password2.218.218.253:5432
# PROXY_FILE=proxies.txt

