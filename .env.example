# Database Connection Settings
DB_DRIVER={ODBC Driver 17 for SQL Server}
# If running locally on Windows: DB_SERVER=localhost (or .\SQLEXPRESS)
# If running inside Docker container to connect to host SQL Server: DB_SERVER=host.docker.internal
DB_SERVER=localhost
DB_NAME=InvestingDB
DB_USER=sa
DB_PASSWORD=your_strong_password
# Note: In Docker, use SQL Server Authentication (DB_TRUSTED_CONNECTION=no) with DB_USER and DB_PASSWORD
DB_TRUSTED_CONNECTION=no
DB_ENCRYPT=no
DB_TRUST_CERT=yes

# Scraper Settings
MAX_PAGES_PER_USER=1
REQUEST_TIMEOUT=15
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=2.5

# API Server Settings (Optional)
API_PORT=3000
LOG_FILE=comment_scraper.log
